# CODE MAZE backend — copy to .env and fill in real values.
# NEVER commit the real .env file.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev default (SQLite, zero setup). For production use PostgreSQL
# (Neon / Render Postgres). The sync URL is used by Alembic migrations.
# Libpq params (sslmode, channel_binding) are stripped automatically.
DATABASE_URL=sqlite+aiosqlite:///./codemaze.db
DATABASE_URL_SYNC=sqlite:///./codemaze.db

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── OCR ─────────────────────────────────────────────────────────────────────
# Engine preference: "tesseract" (lightweight subprocess, recommended for
# small instances e.g. Render free tier) or "rapidocr" (PaddleOCR PP-OCRv4
# ONNX in-process, higher accuracy but ~300MB resident memory).
OCR_ENGINE=tesseract
# Longest image side before OCR. Lower = less CPU/RAM per scan.
OCR_MAX_DIMENSION=1200
# ONNX intra-op threads. Keep at 1 on 0.1-CPU instances to avoid starving
# the event loop (health-check failures -> platform restarts mid-scan).
OCR_THREADS=1
# Fields whose best OCR read is below this confidence become NEEDS_REVIEW.
OCR_CONFIDENCE_THRESHOLD=0.75
# Phase-1 enhancement pipeline (deskew + NL-means denoise + CLAHE + bounded
# upscale) before OCR. Set false only for A/B benchmarking.
OCR_ENHANCE=true
# Tesseract language packs (English + Hindi per Phase 1). The Docker image
# installs tesseract-ocr-eng and tesseract-ocr-hin. Falls back to English-only
# at inference time when a pack is missing on the host.
OCR_LANGUAGES=eng+hin

# ── Storage ─────────────────────────────────────────────────────────────────
# "local" writes under uploads/ (fine for dev; ephemeral on Render).
# "s3" = any S3-compatible object storage: Cloudflare R2 (10 GB free tier),
# Backblaze B2, AWS S3, MinIO. Credentials below, never committed.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Email (optional; mock-delivered and logged when unset) ─────────────────
# Resend free tier: https://resend.com
RESEND_API_KEY=
MAIL_FROM=CODE MAZE <onboarding@resend.dev>
REPORT_RECIPIENT_EMAIL=you@example.com
# Or plain SMTP (e.g. Brevo free tier):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (optional; RQ job queue + rule cache) ────────────────────────────
# Any RESP-compatible service: Valkey 7 (open source), Upstash free Redis,
# Render Redis addon. Unset = scans run in-process (current behaviour).
# When set, run the worker alongside the API:  python -m app.worker
REDIS_URL=

# ── Error tracking (optional) ──────────────────────────────────────────────
# sentry.io free developer tier (5k errors/mo). Empty = fully disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Demo accounts (seed script) ────────────────────────────────────────────
# NO insecure defaults: the seed refuses to run without these set.
DEMO_INSPECTOR_EMAIL=inspector@example.gov.in
DEMO_INSPECTOR_PASSWORD=
DEMO_ADMIN_EMAIL=admin@example.gov.in
DEMO_ADMIN_PASSWORD=
RULE_VERSION_CODE=LMPC-2011-GSR629E-2018

# ── App ────────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
SECURE_COOKIES=false
APP_VERSION=1.0.0
