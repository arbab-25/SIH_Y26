# ============================================================
# CODE MAZE — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Database (Neon PostgreSQL) ──────────────────────────────
# In Render, paste only the value to the right of "=" — never paste the
# full DATABASE_URL=... dotenv assignment into the DATABASE_URL value field.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── Redis (optional, for rate limiting) ─────────────────────
REDIS_URL=

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-long-random
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
GUEST_FREE_SCANS=3

# ── SMTP (Brevo free tier or Gmail App Password) ───────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@codemaze.app
MAIL_FROM="CODE MAZE <onboarding@resend.dev>"

# ── Report Email ────────────────────────────────────────────
REPORT_RECIPIENT_EMAIL=arbab.momin.2008@gmail.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Object Storage (Supabase) ──────────────────────────────
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=codemaze-labels

# ── OCR ─────────────────────────────────────────────────────
OCR_CONFIDENCE_THRESHOLD=0.75
OCR_ENGINE=tesseract
# Options: tesseract, paddleocr

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
