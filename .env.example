# ============================================================
# CODE MAZE — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Database (Neon PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/codemaze
DATABASE_URL_SYNC=postgresql://user:password@host/codemaze

# ── Redis (optional, for rate limiting) ─────────────────────
REDIS_URL=

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── SMTP (Brevo free tier or Gmail App Password) ───────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@codemaze.app

# ── Report Email ────────────────────────────────────────────
REPORT_RECIPIENT_EMAIL=arbab.momin.2008@gmail.com

# ── Object Storage (Supabase) ──────────────────────────────
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=codemaze-uploads

# ── OCR ─────────────────────────────────────────────────────
OCR_CONFIDENCE_THRESHOLD=0.75
OCR_ENGINE=tesseract
# Options: tesseract, paddleocr

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
RESEND_API_KEY=
